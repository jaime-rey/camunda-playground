<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_02fzjdu" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="credit-request" name="Credit Card Request" isExecutable="true">
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request received">
      <bpmn:outgoing>Flow_1inpyyd</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1inpyyd" sourceRef="StartEvent_RequestReceived" targetRef="Subprocess_CreditAnalysis" />
    <bpmn:exclusiveGateway id="Gateway_ScoreCheck" name="Decision Result" default="Flow_1wglqjy">
      <bpmn:incoming>Flow_1qiav36</bpmn:incoming>
      <bpmn:outgoing>Flow_1p4b38t</bpmn:outgoing>
      <bpmn:outgoing>Flow_0k3aeam</bpmn:outgoing>
      <bpmn:outgoing>Flow_1wglqjy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1p4b38t" name="auto" sourceRef="Gateway_ScoreCheck" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dmnReason == "AUTO_APPROVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AutoApprove" name="Auto-approve" camunda:delegateExpression="${autoApproveDelegate}">
      <bpmn:incoming>Flow_1p4b38t</bpmn:incoming>
      <bpmn:outgoing>Flow_05oszjq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved">
      <bpmn:incoming>Flow_1jv1n61</bpmn:incoming>
      <bpmn:incoming>Flow_0hvcaxl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0k3aeam" name="manual" sourceRef="Gateway_ScoreCheck" targetRef="Task_ManualReview">
      <bpmn:extensionElements />
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dmnReason == "MANUAL_REVIEW_REQUIRED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ManualReview" name="Manual review" camunda:assignee="admin">
      <bpmn:incoming>Flow_0k3aeam</bpmn:incoming>
      <bpmn:outgoing>Flow_0jgiken</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManualDecision" name="Approved?" default="Flow_0poglr9">
      <bpmn:incoming>Flow_0jgiken</bpmn:incoming>
      <bpmn:outgoing>Flow_0poglr9</bpmn:outgoing>
      <bpmn:outgoing>Flow_1jv1n61</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0jgiken" sourceRef="Task_ManualReview" targetRef="Gateway_ManualDecision" />
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:incoming>Flow_0poglr9</bpmn:incoming>
      <bpmn:incoming>Flow_1wglqjy</bpmn:incoming>
      <bpmn:incoming>Flow_timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0poglr9" name="no" sourceRef="Gateway_ManualDecision" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_1jv1n61" name="yes" sourceRef="Gateway_ManualDecision" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1wglqjy" name="Default" sourceRef="Gateway_ScoreCheck" targetRef="EndEvent_Rejected" />
    <bpmn:subProcess id="Subprocess_CreditAnalysis" name="Credit analysis">
      <bpmn:incoming>Flow_1inpyyd</bpmn:incoming>
      <bpmn:outgoing>Flow_1qiav36</bpmn:outgoing>
      <bpmn:startEvent id="Event_0xb5ieh">
        <bpmn:outgoing>Flow_12o6iam</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_VerifyHistory" name="Verify credit history" camunda:delegateExpression="${verifyCreditHistoryDelegate}">
        <bpmn:incoming>Flow_12o6iam</bpmn:incoming>
        <bpmn:outgoing>Flow_0cborp0</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="Task_EvaluateRules" name="Evaluate credit rules" camunda:resultVariable="creditRulesRaw" camunda:decisionRef="credit-approval">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="dmnApproved">${creditRulesRaw[0].approved}</camunda:outputParameter>
            <camunda:outputParameter name="dmnReason">${creditRulesRaw[0].reason}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_10fdl42</bpmn:incoming>
        <bpmn:outgoing>Flow_0t41pnr</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_12o6iam" sourceRef="Event_0xb5ieh" targetRef="Task_VerifyHistory" />
      <bpmn:endEvent id="Event_1mcs9i4" name="InnerEnd">
        <bpmn:incoming>Flow_0t41pnr</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0t41pnr" sourceRef="Task_EvaluateRules" targetRef="Event_1mcs9i4" />
      <bpmn:sequenceFlow id="Flow_0cborp0" sourceRef="Task_VerifyHistory" targetRef="Task_ReviewApplication" />
      <bpmn:userTask id="Task_ReviewApplication" name="Review application" camunda:assignee="admin">
        <bpmn:incoming>Flow_0cborp0</bpmn:incoming>
        <bpmn:outgoing>Flow_10fdl42</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_10fdl42" sourceRef="Task_ReviewApplication" targetRef="Task_EvaluateRules" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1qiav36" sourceRef="Subprocess_CreditAnalysis" targetRef="Gateway_ScoreCheck" />
    <bpmn:boundaryEvent id="BoundaryTimer_AnalysisTimeout" name="1m" attachedToRef="Subprocess_CreditAnalysis">
      <bpmn:outgoing>Flow_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_AnalysisTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_timeout" name="timeout" sourceRef="BoundaryTimer_AnalysisTimeout" targetRef="EndEvent_Rejected">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;dmnReason&#34;, &#34;TIMEOUT&#34;)}" event="take" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05oszjq" sourceRef="Task_AutoApprove" targetRef="Task_AssignTier" />
    <bpmn:businessRuleTask id="Task_AssignTier" name="Assign card tier" camunda:resultVariable="cardTierRaw" camunda:decisionRef="card-tier">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="cardTier">${cardTierRaw[0].cardTier}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05oszjq</bpmn:incoming>
      <bpmn:outgoing>Flow_0hvcaxl</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0hvcaxl" sourceRef="Task_AssignTier" targetRef="EndEvent_Approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="credit-request">
